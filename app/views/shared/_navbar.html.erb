<!-- app/views/shared/_navbar.html.erb -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <!-- Logo -->
      <div class="flex-shrink-0 text-2xl font-bold text-indigo-600">
        <%= link_to "JobBoard", root_path, class: "hover:text-indigo-800" %>
      </div>

      <!-- Right Menu -->
      <div class="hidden md:flex space-x-4 items-center">
        <% if user_signed_in? %>
          <span class="text-sm text-gray-700">Welcome, <%= current_user.email %></span>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete },
                class: "bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-md transition" %>
        <% else %>
          <%= link_to "Sign Up", new_user_registration_path,
                class: "bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-md transition" %>
                
          <%= link_to "Log In", new_user_session_path,
                class: "bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-md transition" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
