<% if flash.any? %>
  <div class="fixed bottom-6 right-6 z-50 space-y-4 w-[36rem]">
    <% flash.each do |type, message| %>
      <%# Define Tailwind classes based on the flash type %>
      <% bg_class, border_class, text_class, button_class = case type.to_sym
        when :notice, :success
          ['bg-green-100', 'border-green-600', 'text-green-900', 'text-green-700']
        when :alert, :error
          ['bg-red-100', 'border-red-600', 'text-red-900', 'text-red-700']
        else
          ['bg-gray-100', 'border-gray-600', 'text-gray-900', 'text-gray-700']
        end %>

      <div
        data-controller="toast"
        data-toast-delay-value="4000"
        class="toast <%= bg_class %> <%= border_class %> border-l-4 p-6 rounded-lg shadow-2xl flex justify-between items-start text-lg w-full">
        <div class="flex-1 pr-6 leading-relaxed text-[1.125rem] font-medium <%= text_class %>">
          <%= message %>
        </div>
        <button
          data-action="click->toast#close"
          class="font-bold text-2xl leading-none <%= button_class %> hover:text-black">&times;</button>
      </div>
    <% end %>
  </div>
<% end %>
