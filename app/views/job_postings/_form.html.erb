<div class="max-w-2xl mx-auto px-4">
  <h1 class="text-4xl font-bold text-center my-8">New Job Posting</h1>

  <%= form_with(model: job_posting, local: true, class: "space-y-4") do |f| %>
    <div>
      <%= f.label :title, class: "block text-sm font-medium" %>
      <%= f.text_field :title, class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium" %>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div>
      <%= f.label :location, class: "block text-sm font-medium" %>
      <%= f.text_field :location, class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div>
      <%= f.label :salary_range, class: "block text-sm font-medium" %>
      <%= f.text_field :salary_range, class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div>
      <%= f.label :job_type, "Job Type", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :job_type,
            options_for_select(['Full-time', 'Part-time', 'Contract', 'Internship', 'Freelance'], f.object.job_type),
            {},
            class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div class="text-center">
      <%= f.submit job_posting.new_record? ? "Create Job" : "Update Job", class: "bg-green-600 text-white px-4 py-2 rounded" %>
    </div>
  <% end %>
</div>
