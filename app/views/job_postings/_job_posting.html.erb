<div class="max-w-3xl mx-auto mt-12 px-6 py-8 bg-white rounded-2xl shadow-md border border-gray-200">

  <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">
    <%= job_posting.title %>
  </h1>

  <div class="space-y-4 text-gray-700 text-base leading-relaxed">

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Description</p>
      <p><%= simple_format(job_posting.description) %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Location</p>
      <p><%= job_posting.location %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Salary Range</p>
      <p><%= job_posting.salary_range %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Job Type</p>
      <p><%= job_posting.job_type %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Posted By</p>
      <p><%= job_posting.user.email %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500 font-semibold uppercase">Created At</p>
      <p><%= time_ago_in_words(job_posting.created_at) %> ago</p>
    </div>

  </div>
</div>
