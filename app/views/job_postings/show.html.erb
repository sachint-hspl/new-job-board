<p style="color: green"><%= notice %></p>

<%= render @job_posting %>

<div class="flex justify-center gap-4 mt-8">
  <% if user_signed_in? && policy(@job_posting).update? %>
    <%= link_to "✏️ Edit", edit_job_posting_path(@job_posting), class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition" %>
  <% end %>
    <%= link_to "🔙 Back", job_postings_path, class: "bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition" %>

  <% if user_signed_in? && policy(@job_posting).destroy? %>
  <%= button_to "🗑️ Delete", @job_posting, method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600" %>
  <% end %>
  <% if user_signed_in? && current_user.has_role?("JOB_SEEKER") %>
  <% if @job_posting.job_applications.exists?(user: current_user) %>
      <span class="text-green-600 font-semibold px-4 py-2">✅ Already Submitted</span>
    <% else %>
      <%= link_to "Apply Now", new_job_posting_job_application_path(@job_posting), class: "bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition" %>
    <% end %>
  <% end %>
  <% if user_signed_in? && (current_user == @job_posting.user || current_user.has_role?('EMPLOYER')) %>
    <%= link_to "View Applications", job_posting_job_applications_path(@job_posting), class: "bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition" %>
  <% end %>
</div>
